{
  "name": "eleventy-daisy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/assets/css/input.css -o ./dist/assets/css/styles.css",
    "build:11ty": "eleventy",
    "build": "npm run build:css && npm run build:11ty",
    "run:11ty": "eleventy --serve",
    "run:css": "tailwindcss -i ./src/assets/css/input.css -o ./dist/assets/css/styles.css --watch",
    "start": "concurrently \"pnpm run run:11ty\" \"pnpm run run:css\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.4",
    "tailwindcss": "^4.3.3"
  }
}
