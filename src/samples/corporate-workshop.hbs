<div id="book" class="py-20 max-w-4xl mx-auto px-4">
<div class="card bg-base-100 border border-base-300 shadow-2xl p-6 md:p-10">
  <h2 class="text-3xl font-bold text-center mb-2">Book a Workshop for Your Team</h2>
  <p class="text-center text-sm opacity-70 mb-8">Fill out the details below to receive custom topic outlines and pricing within 24 hours.</p>

  <form class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="label"><span class="label-text font-semibold">Your Name</span></label>
        <input type="text" placeholder="Jane Doe" class="input input-bordered w-full" />
      </div>
      <div>
        <label class="label"><span class="label-text font-semibold">Work Email</span></label>
        <input type="email" placeholder="jane@company.com" class="input input-bordered w-full" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="label"><span class="label-text font-semibold">Company Name</span></label>
        <input type="text" placeholder="Acme Corp" class="input input-bordered w-full" />
      </div>
      <div>
        <label class="label"><span class="label-text font-semibold">Preferred Format</span></label>
        <select class="select select-bordered w-full">
          <option disabled selected>Select format</option>
          <option>In-Person Keynote / Workshop</option>
          <option>Virtual Live Masterclass</option>
          <option>Multi-Session Series</option>
        </select>
      </div>
    </div>

    <div>
      <label class="label"><span class="label-text font-semibold">Event Details / Desired Topic</span></label>
      <textarea class="textarea textarea-bordered w-full" rows="3" placeholder="Tell us about your event, team size, target dates, or specific training goals..."></textarea>
    </div>

    <button type="button" class="btn btn-primary w-full btn-lg mt-4">Request Proposal & Availability</button>
  </form>
</div>
</div>

